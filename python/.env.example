# ===== Python 计算层配置模板 =====
# 复制为 .env 后按需修改；生产环境所有密钥必须从环境变量注入，禁止提交明文。
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000

# LangGraph: memory 仅用于本地；生产用独立 Redis 8 / Redis Stack。
GRAPH_CHECKPOINT_BACKEND=memory
GRAPH_CHECKPOINT_REDIS_URL=
GRAPH_CHECKPOINT_TTL_SECONDS=86400
GRAPH_EXECUTION_LEASE_SECONDS=60
GRAPH_EXECUTION_LOCK_WAIT_SECONDS=180
GRAPH_VERSION=review-v1
# degrade=专家失败后生成报告并要求人工复核；raise=保留失败位置等待重试。
GRAPH_PARALLEL_FAILURE_MODE=degrade

# Optional Langfuse v4 tracing. Create project keys in Cloud or your own server.
LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_RELEASE=
LANGFUSE_SAMPLE_RATE=1.0
# false exports structure/metrics only; true captures bounded, redacted content.
LANGFUSE_CAPTURE_CONTENT=false
LANGFUSE_MAX_CONTENT_CHARS=8000
LANGFUSE_TIMEOUT_SECONDS=3

# 数据库/缓存：统一使用 pymysql 驱动（与主编排、Java 端 3307 端口一致）
MYSQL_URL=mysql+pymysql://review:reviewdb123@localhost:3307/review
REDIS_URL=redis://localhost:6379/0
# sql=生产(MySQL) / inmemory=开发(内存，重启丢失)
PERSISTENCE_BACKEND=inmemory

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=admin123
MINIO_BUCKET=review-reports
MINIO_IMAGE_BUCKET=incident-images

# ChromaDB 向量库（文件型）
CHROMA_PATH=D:/Chroma
CHROMA_COLLECTION=incident_vectors
# Elasticsearch 关键词检索
ELASTICSEARCH_URL=http://localhost:9200
ES_INDEX_NAME=incident_keywords

LLM_API_BASE=http://172.23.255.8:31608/v1
LLM_API_KEY=dev-key
LLM_MODEL=qwen-plus
LLM_DISABLE_THINKING=true
EMBEDDING_MODEL=microsoft/codebert-base

# --- Optional Jev routing over MCP (off by default) ---
JEV_REVIEW_ROUTING_ENABLED=false
JEV_MCP_URL=http://localhost:8001/mcp
JEV_ROUTE_CONFIDENCE_THRESHOLD=0.80
JEV_MCP_TIMEOUT_SECONDS=3.0
TYPESAFE_API_URL=https://api.typesafe.ai/v1/systemone
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

RRF_K=60
RAG_MAX_TOKENS=2000

# --- Kafka 异步链路 (Java 生产者 → Python 消费者 → 回调回 Java) ---
# 回滚开关：false 时完全不启动消费者/生产者
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=python-review-worker
KAFKA_REVIEW_TASKS_TOPIC=ai.review.tasks
KAFKA_REVIEW_CALLBACKS_TOPIC=ai.review.callbacks
# 并发上限（对齐 LLM 配额）
KAFKA_MAX_CONCURRENCY=4
# SASL 鉴权占位（内网可 PLAINTEXT）
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

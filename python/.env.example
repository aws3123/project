APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
MYSQL_URL=mysql://user:pass@localhost:3306/review
REDIS_URL=redis://localhost:6379/0
PERSISTENCE_BACKEND=sql

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=admin123
MINIO_BUCKET=review-reports

CHROMA_PATH=D:/Chroma
CHROMA_COLLECTION=incident_vectors

LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-3b25bf58850f4a8eb4936b55ddc7e145
LLM_MODEL=qwen-plus
EMBEDDING_MODEL=microsoft/codebert-base

RRF_K=60
RAG_MAX_TOKENS=2000

# --- Kafka 异步链路 (Java 生产者 → Python 消费者 → 回调回 Java) ---
# 回滚开关：false 时完全不启动消费者/生产者
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=python-review-worker
KAFKA_REVIEW_TASKS_TOPIC=ai.review.tasks
KAFKA_REVIEW_CALLBACKS_TOPIC=ai.review.callbacks
# 并发上限（对齐 LLM 配额）
KAFKA_MAX_CONCURRENCY=4
# SASL 鉴权占位（内网可 PLAINTEXT）
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

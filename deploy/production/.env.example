# Copy this file to deploy/production/.env and replace every CHANGE_ME value.
# This file is safe to commit; deploy/production/.env is intentionally ignored.

# Host-only interfaces (the host Nginx proxies APP_HOST_PORT over HTTPS).
APP_HOST_PORT=8088
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3001

# MySQL
MYSQL_DATABASE=review
MYSQL_USER=review
MYSQL_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_USE_A_DIFFERENT_LONG_RANDOM_PASSWORD

# Redis
REDIS_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD

# LangGraph checkpoints run on the separate graph-checkpoints Redis 8 service.
GRAPH_CHECKPOINT_TTL_SECONDS=86400
GRAPH_VERSION=review-v1
GRAPH_PARALLEL_FAILURE_MODE=degrade

# Optional Langfuse Cloud / self-hosted endpoint and project keys.
LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_RELEASE=
LANGFUSE_SAMPLE_RATE=1.0
LANGFUSE_CAPTURE_CONTENT=false
LANGFUSE_MAX_CONTENT_CHARS=8000
LANGFUSE_TIMEOUT_SECONDS=3

# MinIO
MINIO_ROOT_USER=sentinel-admin
MINIO_ROOT_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
MINIO_REPORT_BUCKET=review-reports
MINIO_IMAGE_BUCKET=incident-images

# Application-to-application authentication
API_KEY=CHANGE_ME_USE_A_LONG_RANDOM_TOKEN
CALLBACK_TOKEN=CHANGE_ME_USE_A_LONG_RANDOM_TOKEN
BUSINESS_RISK_WORKER_TOKEN=CHANGE_ME_USE_A_LONG_RANDOM_TOKEN

# External LLM endpoint
LLM_API_BASE=https://llm.example.com/v1
LLM_API_KEY=CHANGE_ME_USE_A_PROVIDER_TOKEN
LLM_MODEL=qwen-plus

# Optional Jev review routing. Keep disabled until validated on labeled PRs.
JEV_REVIEW_ROUTING_ENABLED=false
JEV_ROUTE_CONFIDENCE_THRESHOLD=0.80
JEV_MCP_TIMEOUT_SECONDS=3.0
TYPESAFE_API_URL=https://api.typesafe.ai/v1/systemone
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# Grafana local administration
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
